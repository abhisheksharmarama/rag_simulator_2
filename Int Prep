  const body = document.createElement('div');
  body.className = 'phase-body';
  body.id = `phase-body-${pi}`;

  // open first phase by default
  if(pi === 0){ hd.classList.add('open'); body.classList.add('open'); }

  hd.addEventListener('click', () => {
    hd.classList.toggle('open');
    body.classList.toggle('open');
  });

  const list = document.createElement('div');
  list.className = 'days-list';

  phase.days.forEach((day, di) => {
    const dayNum = globalDayIndex + di + 1;
    const card = document.createElement('div');
    card.className = 'day';
    card.id = `day-${dayNum}`;
    card.style.setProperty('--dc', day.color);

    const tagHTML = day.tags.map(([cls,label]) => `<span class="tag ${cls}">${label}</span>`).join('');
    const taskHTML = day.tasks.map(t => `<li>${t}</li>`).join('');

    card.innerHTML = `
      <div class="day-n">D${dayNum}</div>
      <div class="day-info">
        <div class="day-title">${day.title}</div>
        <div class="day-cat">${day.cat}</div>
        <ul class="day-tasks">${taskHTML}</ul>
        <div class="day-tags">${tagHTML}</div>
      </div>
      <div class="cb" id="cb-${dayNum}" onclick="toggleDay(${dayNum}, event)"></div>
    `;

    card.addEventListener('click', () => toggleDay(dayNum));
    list.appendChild(card);
  });

  globalDayIndex += phase.days.length;

  body.appendChild(list);
  wrap.appendChild(hd);
  wrap.appendChild(body);
  planEl.appendChild(wrap);
});

// ═══════════ STATE ═══════════
function getState(){ try{ return JSON.parse(localStorage.getItem('pm30_v2')||'{}') }catch(e){return {}} }
function setState(s){ localStorage.setItem('pm30_v2', JSON.stringify(s)) }

function getTotalTasks(){
  return PLAN.reduce((a,p)=>a+p.days.reduce((b,d)=>b+d.tasks.length,0),0);
}

function toggleDay(num, e){
  if(e) e.stopPropagation();
  const s = getState();
  const done = !!s[`d${num}`];
  s[`d${num}`] = !done;
  if(!done) s[`d${num}_ts`] = Date.now();
  else delete s[`d${num}_ts`];
  setState(s);
  renderState();
  showToast(!done ? `Day ${num} marked complete ✓` : `Day ${num} unmarked`);
}

function renderState(){
  const s = getState();
  let doneCount = 0;
  let totalDays = 0;
  let phaseDone = [0,0,0,0];

  // total tasks
  const totalTasks = getTotalTasks();
  let doneTasks = 0;

  globalDayIndex = 0;
  PLAN.forEach((phase, pi) => {
    phase.days.forEach((day, di) => {
      const dayNum = globalDayIndex + di + 1;
      totalDays++;
      const card = document.getElementById(`day-${dayNum}`);
      const cb = document.getElementById(`cb-${dayNum}`);
      if(!card) return;
      if(s[`d${dayNum}`]){
        card.classList.add('done'); card.classList.remove('today');
        cb.classList.add('checked'); cb.textContent = '✓';
        doneCount++; phaseDone[pi]++;
        doneTasks += day.tasks.length;
      } else {
        card.classList.remove('done');
        cb.classList.remove('checked'); cb.textContent = '';
      }
    });
    globalDayIndex += phase.days.length;
    const pStat = document.getElementById(`ph-stat-${pi}`);
    if(pStat) pStat.textContent = `${phaseDone[pi]}/${phase.days.length}`;
  });

  // update stats
  document.getElementById('sDays').innerHTML = `${doneCount}<em>/30</em>`;
  document.getElementById('sTasks').innerHTML = `${doneTasks}<em>tasks</em>`;
  document.getElementById('sTotal').textContent = totalTasks;
  document.getElementById('sHint').textContent = doneCount === 30 ? '🏆 Complete!' : doneCount === 0 ? 'Start today 🚀' : `${30-doneCount} days remaining`;

  const pct = Math.round((doneCount/30)*100);
  document.getElementById('pctLabel').textContent = pct + '%';
  document.getElementById('progFill').style.width = pct + '%';

  // phase
  const phaseNames = ['Foundations','Core Toolkit','Advanced + AI','Interview Mastery'];
  let curPhase = 0;
  let g = 0;
  PLAN.forEach((p,i)=>{ if(doneCount >= g && doneCount < g + p.days.length) curPhase = i; g += p.days.length; });
  document.getElementById('sPhase').innerHTML = `Ph ${curPhase+1}`;
  document.getElementById('sPhaseName').textContent = phaseNames[curPhase];

  // streak (simplified: consecutive days from most recent)
  let streak = 0;
  let check = doneCount;
  for(let i=check; i>=1; i--){
    if(s[`d${i}`]) streak++;
    else break;
  }
  document.getElementById('sStreak').innerHTML = `${streak}<em>days</em>`;
}

// ═══════════ NOTES ═══════════
function saveNote(id, val){ const s = getState(); s['note_'+id] = val; setState(s); }
function loadNotes(){
  const s = getState();
  ['n1','n2','n3','n4','n5','n6'].forEach(id => {
    const el = document.getElementById(id);
    if(el && s['note_'+id]) el.value = s['note_'+id];
  });
}

// ═══════════ TOAST ═══════════
let toastTimer;
function showToast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=>t.classList.remove('show'), 2800);
}

// ═══════════ INIT ═══════════
renderState();
loadNotes();
</script>
