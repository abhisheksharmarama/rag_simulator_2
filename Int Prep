<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0"/>
<title>Abhishek's PM Mastery – 30-Day Training Tracker</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,500&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet"/>
<style>
:root{
  --bg:#080a0f;--bg2:#0e1118;--bg3:#13161e;--card:#111520;
  --border:#1a1f2e;--border2:#242b3d;
  --gold:#c9a84c;--gold2:#e8c97a;--gold3:#f8e9b8;--golddim:rgba(201,168,76,.13);--goldglow:rgba(201,168,76,.06);
  --green:#3ecf8e;--greendim:rgba(62,207,142,.1);
  --blue:#4e9eff;--bluedim:rgba(78,158,255,.1);
  --purple:#a78bfa;--purpledim:rgba(167,139,250,.1);
  --orange:#fb923c;--orangedim:rgba(251,146,60,.1);
  --red:#f87272;--reddim:rgba(248,114,114,.1);
  --text:#e4e9f5;--text2:#8892aa;--text3:#464f6a;
  --r:12px;--rs:8px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);line-height:1.6;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse 80% 50% at 50% -10%,rgba(201,168,76,.07),transparent);pointer-events:none;z-index:0}
.wrap{max-width:1100px;margin:0 auto;padding:0 20px;position:relative;z-index:1}

/* ─── HEADER ─── */
header{padding:56px 0 36px;border-bottom:1px solid var(--border);position:relative}
header::after{content:'';position:absolute;bottom:-1px;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent 5%,var(--gold) 50%,transparent 95%)}
.badge{display:inline-flex;align-items:center;gap:7px;background:var(--golddim);border:1px solid rgba(201,168,76,.35);color:var(--gold2);font-size:10.5px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;padding:5px 14px;border-radius:100px;margin-bottom:18px}
.badge .dot{width:6px;height:6px;border-radius:50%;background:var(--gold);animation:blink 2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}
h1{font-family:'Playfair Display',serif;font-size:clamp(34px,5.5vw,60px);font-weight:700;line-height:1.08;background:linear-gradient(135deg,var(--gold3),var(--gold2) 45%,var(--gold) 75%,#9a6e18);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:10px}
.sub{color:var(--text2);font-size:15px;max-width:620px;font-weight:300;margin-bottom:24px}
.header-pills{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px}
.pill{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--text2);background:var(--bg3);border:1px solid var(--border);border-radius:100px;padding:5px 14px}
.pill strong{color:var(--text);font-weight:600}

/* ─── PROFILE CARD ─── */
.profile-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:22px 26px;margin:28px 0;display:flex;gap:20px;align-items:flex-start;position:relative;overflow:hidden}
.profile-card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--gold),var(--gold2))}
.profile-avatar{width:52px;height:52px;border-radius:12px;background:var(--golddim);border:2px solid var(--gold);display:flex;align-items:center;justify-content:center;font-family:'Playfair Display',serif;font-size:20px;font-weight:700;color:var(--gold2);flex-shrink:0}
.profile-meta h3{font-size:17px;font-weight:600;margin-bottom:3px}
.profile-meta p{font-size:12.5px;color:var(--text2)}
.profile-strengths{margin-top:14px;display:flex;flex-wrap:wrap;gap:8px}
.strength{font-size:11px;background:var(--greendim);color:var(--green);border:1px solid rgba(62,207,142,.2);border-radius:100px;padding:3px 10px;font-weight:600}
.gap-tag{font-size:11px;background:var(--reddim);color:var(--red);border:1px solid rgba(248,114,114,.2);border-radius:100px;padding:3px 10px;font-weight:600}

/* ─── STATS ─── */
.stats-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:28px 0}
@media(max-width:700px){.stats-row{grid-template-columns:repeat(2,1fr)}}
.stat{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:18px 20px;position:relative;overflow:hidden;transition:.25s}
.stat:hover{border-color:var(--border2);transform:translateY(-2px)}
.stat::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--statline,linear-gradient(90deg,var(--gold),var(--gold2)))}
.stat-label{font-size:10.5px;text-transform:uppercase;letter-spacing:.1em;color:var(--text3);font-weight:600;margin-bottom:7px}
.stat-val{font-family:'DM Mono',monospace;font-size:32px;font-weight:500;line-height:1;color:var(--text)}
.stat-val em{font-style:normal;font-size:13px;color:var(--text2);font-family:'DM Sans',sans-serif;font-weight:400}
.stat-hint{font-size:11.5px;color:var(--text3);margin-top:5px}

/* ─── PROGRESS BAR ─── */
.prog-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:22px 26px;margin-bottom:36px}
.prog-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}
.prog-top span{font-size:13px;font-weight:500;color:var(--text2)}
.prog-top strong{font-family:'DM Mono',monospace;font-size:24px;color:var(--gold2)}
.prog-track{height:10px;background:var(--bg3);border-radius:100px;overflow:hidden}
.prog-fill{height:100%;background:linear-gradient(90deg,#a07820,var(--gold),var(--gold2));border-radius:100px;transition:width .9s cubic-bezier(.4,0,.2,1);min-width:3px}
.prog-phases{display:flex;justify-content:space-between;margin-top:9px}
.prog-phases span{font-size:10px;color:var(--text3);font-family:'DM Mono',monospace}

/* ─── MARKET INSIGHTS ─── */
.insights-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px;margin:20px 0 44px}
.insight{background:var(--bg2);border:1px solid var(--border);border-radius:var(--rs);padding:14px 16px;display:flex;gap:12px;transition:.2s}
.insight:hover{border-color:var(--border2)}
.i-icon{font-size:22px;flex-shrink:0;line-height:1.2}
.i-text strong{font-size:12.5px;color:var(--text);display:block;margin-bottom:2px}
.i-text span{font-size:11.5px;color:var(--text2)}

/* ─── SECTION HEADING ─── */
.sec-head{margin:44px 0 4px}
.sec-title{font-family:'Playfair Display',serif;font-size:clamp(20px,3vw,27px);font-weight:700}
.sec-title em{font-style:italic;color:var(--gold2)}
.sec-desc{font-size:13.5px;color:var(--text2);margin-top:4px;margin-bottom:22px}

/* ─── PHASE HEADER ─── */
.phase-wrap{margin-bottom:6px}
.phase-hd{
  display:flex;align-items:center;gap:14px;padding:16px 20px;
  background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);
  cursor:pointer;user-select:none;transition:.2s;margin-bottom:0
}
.phase-hd:hover{border-color:var(--border2)}
.ph-badge{width:34px;height:34px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;font-family:'DM Mono',monospace;flex-shrink:0}
.ph-info{flex:1}
.ph-name{font-weight:600;font-size:15px}
.ph-days{font-size:11.5px;color:var(--text2);margin-top:1px}
.ph-stat{text-align:right;font-size:11.5px;color:var(--text2)}
.ph-stat strong{display:block;font-family:'DM Mono',monospace;font-size:15px;color:var(--text)}
.ph-chevron{color:var(--text3);transition:.3s;font-size:16px}
.phase-hd.open .ph-chevron{transform:rotate(180deg)}
.phase-body{display:none;padding:8px 0 4px}
.phase-body.open{display:block}

/* ─── DAY CARDS ─── */
.days-list{display:flex;flex-direction:column;gap:8px}
.day{
  background:var(--card);border:1px solid var(--border);border-radius:var(--r);
  padding:16px 18px;display:grid;grid-template-columns:42px 1fr 30px;align-items:start;gap:14px;
  cursor:pointer;transition:.22s;position:relative;overflow:hidden
}
.day::after{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--dc,var(--gold));opacity:0;transition:.2s;border-radius:3px 0 0 3px}
.day:hover{border-color:var(--border2)}.day:hover::after{opacity:.5}
.day.done{background:rgba(62,207,142,.04);border-color:rgba(62,207,142,.18)}.day.done::after{opacity:1;background:var(--green)}
.day.today{border-color:rgba(201,168,76,.3);background:var(--goldglow)}.day.today::after{opacity:1}
.day-n{width:38px;height:38px;border-radius:8px;background:var(--bg3);display:flex;align-items:center;justify-content:center;font-family:'DM Mono',monospace;font-size:12.5px;font-weight:500;color:var(--text2);flex-shrink:0;margin-top:1px;transition:.2s}
.day.done .day-n{background:var(--greendim);color:var(--green)}
.day.today .day-n{background:var(--golddim);color:var(--gold2)}
.day-info{}
.day-title{font-weight:600;font-size:14.5px;margin-bottom:3px}
.day.done .day-title{color:var(--text2)}
.day-cat{font-size:10.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--text3);font-family:'DM Mono',monospace;margin-bottom:7px}
.day-tasks{list-style:none;display:flex;flex-direction:column;gap:3px}
.day-tasks li{font-size:12.5px;color:var(--text2);padding-left:14px;position:relative}
.day-tasks li::before{content:'›';position:absolute;left:0;color:var(--text3)}
.day.done .day-tasks li{text-decoration:line-through;opacity:.55}
.day-tags{display:flex;flex-wrap:wrap;gap:5px;margin-top:9px}
.tag{font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;font-weight:600;padding:2px 8px;border-radius:100px}
.ts{background:var(--purpledim);color:var(--purple);border:1px solid rgba(167,139,250,.2)}
.tt{background:var(--bluedim);color:var(--blue);border:1px solid rgba(78,158,255,.2)}
.to{background:var(--orangedim);color:var(--orange);border:1px solid rgba(251,146,60,.2)}
.ti{background:var(--reddim);color:var(--red);border:1px solid rgba(248,114,114,.2)}
.tg{background:var(--greendim);color:var(--green);border:1px solid rgba(62,207,142,.2)}

/* checkbox */
.cb{width:24px;height:24px;border-radius:6px;border:2px solid var(--border2);display:flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:3px;cursor:pointer;transition:.2s;background:transparent;font-size:0}
.cb:hover{border-color:var(--gold);background:var(--golddim)}
.day.done .cb{background:var(--green);border-color:var(--green);font-size:13px;color:var(--bg);font-weight:700}

/* ─── NOTES ─── */
.notes-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:14px;margin-top:14px}
.note{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:16px 18px}
.note-label{font-size:10.5px;text-transform:uppercase;letter-spacing:.1em;color:var(--gold);font-weight:600;margin-bottom:9px}
textarea{width:100%;background:var(--bg3);border:1px solid var(--border2);border-radius:var(--rs);padding:10px 12px;font-family:'DM Sans',sans-serif;font-size:12.5px;color:var(--text);resize:vertical;min-height:70px;outline:none;transition:.2s;line-height:1.5}
textarea:focus{border-color:var(--gold);background:var(--bg2)}
textarea::placeholder{color:var(--text3)}

/* ─── RESOURCES ─── */
.res-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;margin-top:16px}
.res-card{background:var(--card);border:1px solid var(--border);border-radius:var(--r);padding:18px 20px;transition:.2s}
.res-card:hover{border-color:var(--border2);transform:translateY(-2px)}
.res-cat{font-size:10px;text-transform:uppercase;letter-spacing:.1em;color:var(--gold);font-weight:700;margin-bottom:11px;display:flex;align-items:center;gap:8px}
.res-cat::after{content:'';flex:1;height:1px;background:var(--border)}
.res-list{list-style:none;display:flex;flex-direction:column;gap:7px}
.res-list li{font-size:12.5px;color:var(--text2);display:flex;align-items:flex-start;gap:7px}
.res-list li::before{content:'⬥';color:var(--gold);font-size:9px;flex-shrink:0;margin-top:3px}
.res-list a{color:var(--blue);text-decoration:none}.res-list a:hover{text-decoration:underline}

/* ─── TOAST ─── */
.toast{position:fixed;bottom:28px;right:28px;z-index:999;background:var(--bg2);border:1px solid var(--gold);border-radius:var(--r);padding:12px 20px;font-size:13px;font-weight:500;color:var(--gold2);box-shadow:0 8px 40px rgba(0,0,0,.5);transform:translateY(80px);opacity:0;transition:.35s cubic-bezier(.34,1.56,.64,1);pointer-events:none}
.toast.show{transform:translateY(0);opacity:1}

/* ─── FOOTER ─── */
footer{margin-top:72px;padding:28px 0;border-top:1px solid var(--border);text-align:center;font-size:12px;color:var(--text3)}
footer strong{color:var(--gold)}

/* ─── JD ANALYSIS TABLE ─── */
.jd-table{width:100%;border-collapse:collapse;margin-top:14px;font-size:13px}
.jd-table th{background:var(--bg3);padding:10px 14px;text-align:left;font-size:10.5px;text-transform:uppercase;letter-spacing:.08em;color:var(--text3);font-weight:600;border-bottom:1px solid var(--border)}
.jd-table td{padding:10px 14px;border-bottom:1px solid var(--border);color:var(--text2);vertical-align:top}
.jd-table tr:hover td{background:var(--bg2)}
.jd-table .skill-pill{display:inline-block;background:var(--golddim);color:var(--gold2);border-radius:4px;padding:1px 7px;font-size:11px;font-weight:600;margin:1px 2px}
.freq-bar{background:var(--bg3);border-radius:4px;height:8px;overflow:hidden;width:80px;display:inline-block;vertical-align:middle;margin-left:6px}
.freq-fill{height:100%;background:linear-gradient(90deg,var(--gold),var(--gold2));border-radius:4px}
.table-wrap{overflow-x:auto;background:var(--card);border:1px solid var(--border);border-radius:var(--r);margin-bottom:40px}

/* fade-in */
@keyframes fadeUp{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
.fi{animation:fadeUp .5s ease both}
.fi1{animation-delay:.08s}.fi2{animation-delay:.16s}.fi3{animation-delay:.24s}.fi4{animation-delay:.32s}
</style>
</head>
