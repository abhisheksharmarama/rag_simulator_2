<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>RAG Simulator</title>

<style>
    *{
        margin:0;
        padding:0;
        box-sizing:border-box;
        font-family: Inter, sans-serif;
    }

    body{
        background:#0f172a;
        color:white;
        min-height:100vh;
        padding:30px;
        overflow-x:hidden;
    }

    .container{
        max-width:1400px;
        margin:auto;
    }

    .title{
        text-align:center;
        margin-bottom:30px;
    }

    .title h1{
        font-size:48px;
        font-weight:800;
        background:linear-gradient(90deg,#38bdf8,#818cf8,#c084fc);
        -webkit-background-clip:text;
        -webkit-text-fill-color:transparent;
    }

    .title p{
        color:#94a3b8;
        margin-top:10px;
        font-size:18px;
    }

    .grid{
        display:grid;
        grid-template-columns: 1fr 1fr;
        gap:20px;
    }

    .card{
        background:rgba(255,255,255,0.05);
        border:1px solid rgba(255,255,255,0.08);
        border-radius:20px;
        padding:20px;
        backdrop-filter:blur(10px);
        box-shadow:0 10px 30px rgba(0,0,0,0.3);
    }

    .card h2{
        margin-bottom:15px;
        font-size:22px;
        color:#e2e8f0;
    }

    textarea{
        width:100%;
        min-height:180px;
        background:#020617;
        border:1px solid #334155;
        border-radius:12px;
        padding:15px;
        color:white;
        resize:vertical;
        font-size:15px;
        line-height:1.5;
    }

    input{
        width:100%;
        background:#020617;
        border:1px solid #334155;
        border-radius:12px;
        padding:15px;
        color:white;
        font-size:15px;
        margin-top:10px;
    }

    button{
        background:linear-gradient(90deg,#3b82f6,#8b5cf6);
        border:none;
        padding:14px 20px;
        border-radius:12px;
        color:white;
        font-size:16px;
        font-weight:700;
        cursor:pointer;
        transition:0.3s;
        width:100%;
        margin-top:15px;
    }

    button:hover{
        transform:translateY(-2px);
        opacity:0.9;
    }

    .step{
        margin-bottom:20px;
        padding:16px;
        border-radius:16px;
        background:#111827;
        border:1px solid #1e293b;
    }

    .step-title{
        display:flex;
        align-items:center;
        gap:10px;
        margin-bottom:10px;
        font-weight:700;
        color:#93c5fd;
    }

    .badge{
        width:30px;
        height:30px;
        border-radius:50%;
        background:#2563eb;
        display:flex;
        align-items:center;
        justify-content:center;
        font-size:14px;
        font-weight:bold;
    }

    .chunk{
        background:#1e293b;
        padding:12px;
        border-radius:12px;
        margin-bottom:10px;
        border-left:4px solid #38bdf8;
    }

    .vector{
        font-family:monospace;
        color:#86efac;
        font-size:14px;
        margin-top:5px;
    }

    .retrieved{
        border-left:4px solid #22c55e;
        background:#052e16;
    }

    .llm-box{
        background:#1e1b4b;
        border-left:4px solid #8b5cf6;
    }

    .flow{
        margin-top:25px;
        display:flex;
        flex-wrap:wrap;
        gap:12px;
        justify-content:center;
    }

    .flow-item{
        padding:12px 16px;
        border-radius:12px;
        background:#111827;
        border:1px solid #334155;
        font-size:14px;
    }

    .highlight{
        border-color:#3b82f6;
        background:#1e3a8a;
    }

    @media(max-width:900px){
        .grid{
            grid-template-columns:1fr;
        }
    }
</style>
</head>

<body>

<div class="container">

    <div class="title">
        <h1>RAG Simulator</h1>
        <p>Understand Retrieval-Augmented Generation step-by-step visually.</p>
    </div>

    <div class="grid">

        <!-- LEFT -->
        <div class="card">
            <h2>📚 Knowledge Base</h2>

<textarea id="knowledgeBase">
RAG stands for Retrieval-Augmented Generation.

Chunking splits large documents into smaller pieces.

Embeddings convert text into numerical vector representations.

Vector databases store embeddings for semantic search.

Semantic search finds meaning-based matches instead of keyword matches.

The retrieved context is injected into the prompt before sending to the LLM.

The LLM uses retrieved context to generate grounded responses.
</textarea>

            <button onclick="processKnowledgeBase()">
                Process Knowledge Base
            </button>

            <div class="flow">
                <div class="flow-item" id="flow1">1. Chunking</div>
                <div class="flow-item" id="flow2">2. Embedding</div>
                <div class="flow-item" id="flow3">3. Vector Store</div>
                <div class="flow-item" id="flow4">4. Retrieval</div>
                <div class="flow-item" id="flow5">5. Context Injection</div>
                <div class="flow-item" id="flow6">6. LLM Generation</div>
            </div>

            <div id="knowledgeOutput" style="margin-top:25px;"></div>
        </div>

        <!-- RIGHT -->
        <div class="card">
            <h2>🔍 User Query</h2>

            <input 
                type="text" 
                id="queryInput"
                placeholder="Ask something..."
                value="What are embeddings in RAG?"
            />

            <button onclick="runRAG()">
                Run RAG Pipeline
            </button>

            <div id="queryOutput" style="margin-top:25px;"></div>
        </div>

    </div>
</div>

<script>

let vectorStore = [];

function fakeEmbedding(text){
    return [
        text.length % 100,
        [...text].reduce((a,c)=>a+c.charCodeAt(0),0)%100,
        text.split(" ").length,
        Math.floor(Math.random()*100)
    ];
}

function cosineSimilarity(a,b){
    let dot = 0;

    for(let i=0;i<a.length;i++){
        dot += a[i]*b[i];
    }

    return dot;
}

function highlightFlow(step){
    for(let i=1;i<=6;i++){
        document.getElementById("flow"+i).classList.remove("highlight");
    }

    document.getElementById("flow"+step).classList.add("highlight");
}

function processKnowledgeBase(){

    highlightFlow(1);

    const kb = document.getElementById("knowledgeBase").value;

    const chunks = kb
        .split("\n")
        .filter(c=>c.trim()!=='');

    vectorStore = [];

    let html = '';

    chunks.forEach((chunk,index)=>{

        highlightFlow(2);

        const embedding = fakeEmbedding(chunk);

        vectorStore.push({
            text:chunk,
            embedding
        });

        html += `
            <div class="step">
                <div class="step-title">
                    <div class="badge">${index+1}</div>
                    Chunk Created
                </div>

                <div class="chunk">
                    ${chunk}
                    <div class="vector">
                        Embedding Vector:
                        [${embedding.join(", ")}]
                    </div>
                </div>
            </div>
        `;
    });

    highlightFlow(3);

    html += `
        <div class="step">
            <div class="step-title">
                <div class="badge">✓</div>
                Vector Database Ready
            </div>

            <p style="color:#94a3b8;">
                ${vectorStore.length} chunks stored with embeddings.
            </p>
        </div>
    `;

    document.getElementById("knowledgeOutput").innerHTML = html;
}

function runRAG(){

    if(vectorStore.length===0){
        alert("Process the Knowledge Base first.");
        return;
    }

    const query = document.getElementById("queryInput").value;

    const queryEmbedding = fakeEmbedding(query);

    highlightFlow(4);

    let scored = vectorStore.map(item=>({
        ...item,
        score: cosineSimilarity(queryEmbedding,item.embedding)
    }));

    scored.sort((a,b)=>b.score-a.score);

    const retrieved = scored.slice(0,2);

    let html = '';

    html += `
        <div class="step">
            <div class="step-title">
                <div class="badge">Q</div>
                User Query Embedding
            </div>

            <div class="chunk">
                ${query}

                <div class="vector">
                    Query Vector:
                    [${queryEmbedding.join(", ")}]
                </div>
            </div>
        </div>
    `;

    html += `
        <div class="step">
            <div class="step-title">
                <div class="badge">R</div>
                Semantic Retrieval
            </div>
    `;

    retrieved.forEach(r=>{

        html += `
            <div class="chunk retrieved">
                ${r.text}

                <div class="vector">
                    Similarity Score:
                    ${r.score}
                </div>
            </div>
        `;
    });

    html += `</div>`;

    highlightFlow(5);

    const context = retrieved.map(r=>r.text).join(" ");

    html += `
        <div class="step">
            <div class="step-title">
                <div class="badge">C</div>
                Context Injection
            </div>

            <div class="chunk">
                Retrieved context is appended into the LLM prompt.
            </div>

            <div class="chunk">
                <strong>Injected Context:</strong><br><br>
                ${context}
            </div>
        </div>
    `;

    highlightFlow(6);

    html += `
        <div class="step llm-box">
            <div class="step-title">
                <div class="badge">AI</div>
                LLM Final Response
            </div>

            <div class="chunk">
                Based on retrieved context, embeddings are numerical vector representations of text that help semantic search understand meaning rather than exact keywords.
            </div>
        </div>
    `;

    document.getElementById("queryOutput").innerHTML = html;
}

processKnowledgeBase();

</script>

</body>
</html>
